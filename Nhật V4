local function cycleHipHeight()
    local c = LP.Character
    local h = c and c:FindFirstChildWhichIsA("Humanoid")
    if not h then return end
    hipIdx = hipIdx + 1
    if hipIdx > #hipOptions then hipIdx = 1 end
    h.HipHeight = hipOptions[hipIdx]
    hipHeightBtn.Text = "HipHeight " .. hipOptions[hipIdx]
end

local gravIdx = 1
local gravOptions = {originalGravity, 50, 20, 5, 0}
local function cycleGravity()
    gravIdx = gravIdx + 1
    if gravIdx > #gravOptions then gravIdx = 1 end
    workspace.Gravity = gravOptions[gravIdx]
    gravityBtn.Text = "Gravity " .. math.floor(gravOptions[gravIdx])
end

local function applyWSJP()
    local c = LP.Character
    local h = c and c:FindFirstChildWhichIsA("Humanoid")
    if not h then return end
    local ws = tonumber(wsBox.Text)
    local jp = tonumber(jpBox.Text)
    if ws then h.WalkSpeed = ws end
    if jp then h.JumpPower = jp; h.UseJumpPower = true end
end

local function clearAll()
    if nowe then stopFly(); onof.Text = "click to fly!" end
    if toggles.noclip then
        toggles.noclip = false
        noclipBtn.Text = "Noclip OFF"
        removeNoclip(LP.Character)
    end
    if toggles.xray then
        toggles.xray = false
        xrayBtn.Text = "X-Ray OFF"
        setXray(false)
    end
    if toggles.esp then
        toggles.esp = false
        espBtn.Text = "ESP OFF"
        clearESP()
    end
    if toggles.names then
        toggles.names = false
        namesBtn.Text = "NameTags OFF"
        clearNameTags()
    end
    if toggles.fullBright then
        toggles.fullBright = false
        fullBrightBtn.Text = "FullBright OFF"
        setFullBright(false)
    end
    if toggles.god then
        toggles.god = false
        godBtn.Text = "God OFF"
    end
    if toggles.antiAfk then
        toggles.antiAfk = false
        antiAfkBtn.Text = "Anti AFK OFF"
    end
    if toggles.autoRun then
        toggles.autoRun = false
        autoRunBtn.Text = "Auto Run OFF"
    end
    if toggles.freeze then
        toggles.freeze = false
        freezBtn.Text = "Freeze"
        local c = LP.Character
        local hrp = c and c:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.Anchored = false end
    end
end

noclipBtn.MouseButton1Click:Connect(function()
    toggles.noclip = not toggles.noclip
    noclipBtn.Text = toggles.noclip and "Noclip ON" or "Noclip OFF"
    if toggles.noclip then applyNoclip(LP.Character) else removeNoclip(LP.Character) end
end)

infJumpBtn.MouseButton1Click:Connect(function()
    toggles.infJump = not toggles.infJump
    infJumpBtn.Text = toggles.infJump and "Inf Jump ON" or "Inf Jump OFF"
end)
