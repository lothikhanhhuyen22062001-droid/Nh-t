local function serverHop()
    local Http = game:GetService("HttpService")
    local req = (syn and syn.request) or (http and http.request) or http_request or request
    if not req then
        pcall(function()
            StarterGui:SetCore("SendNotification", {Title="Server Hop", Text="Executor khong ho tro HTTP", Duration=3})
        end)
        return
    end
    pcall(function()
        local url = "https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100"
        local res = req({Url = url, Method = "GET"})
        local data = Http:JSONDecode(res.Body)
        if data and data.data then
            for _, s in ipairs(data.data) do
                if s.playing < s.maxPlayers and s.id ~= game.JobId then
                    game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, s.id, LP)
                    return
                end
            end
        end
    end)
end

local fogOn = false
local function toggleFog()
    local L = game:GetService("Lighting")
    fogOn = not fogOn
    if fogOn then
        savedFog = {FogEnd = L.FogEnd, FogStart = L.FogStart}
        L.FogEnd = 1e6
        L.FogStart = 1e6
        fogBtn.Text = "Restore Fog"
    else
        if savedFog then
            L.FogEnd = savedFog.FogEnd
            L.FogStart = savedFog.FogStart
        end
        fogBtn.Text = "Remove Fog"
    end
end

