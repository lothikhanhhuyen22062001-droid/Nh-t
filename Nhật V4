local ALL_STATES = {
    Enum.HumanoidStateType.Climbing, Enum.HumanoidStateType.FallingDown,
    Enum.HumanoidStateType.Flying, Enum.HumanoidStateType.Freefall,
    Enum.HumanoidStateType.GettingUp, Enum.HumanoidStateType.Jumping,
    Enum.HumanoidStateType.Landed, Enum.HumanoidStateType.Physics,
    Enum.HumanoidStateType.PlatformStanding, Enum.HumanoidStateType.Ragdoll,
    Enum.HumanoidStateType.Running, Enum.HumanoidStateType.RunningNoPhysics,
    Enum.HumanoidStateType.Seated, Enum.HumanoidStateType.StrafingNoPhysics,
    Enum.HumanoidStateType.Swimming,
}

local function setStates(h, e)
    if not h or not h.Parent then return end
    for _, s in ipairs(ALL_STATES) do
        pcall(function() h:SetStateEnabled(s, e) end)
    end
end

local function stopLoops()
    for _, t in ipairs(activeLoops) do
        if typeof(t) == "thread" then pcall(task.cancel, t) end
    end
    activeLoops = {}
end

local function addLoop(fn)
    table.insert(activeLoops, task.spawn(fn))
end

local function startTpWalk()
    tpwalking = true
    for _ = 1, speeds do
        addLoop(function()
            while tpwalking do
                RunService.Heartbeat:Wait()
                local c = LP.Character
                local h = c and c:FindFirstChildWhichIsA("Humanoid")
                if c and h and h.Parent and h.Health > 0 then
                    if h.MoveDirection.Magnitude > 0 then
                        c:TranslateBy(h.MoveDirection)
                    end
                else
                    break
                end
            end
        end)
    end
end

local function stopTpWalk()
    tpwalking = false
    stopLoops()
end

local function resetAnim(c)
    if not c then return end
    local a = c:FindFirstChild("Animate")
    if a then a.Disabled = false end
    local h = c:FindFirstChildWhichIsA("Humanoid")
    if h then
        pcall(function() h.PlatformStand = false end)
        pcall(function()
            for _, v in ipairs(h:GetPlayingAnimationTracks()) do
                v:AdjustSpeed(1)
            end
        end)
    end
end

local function getFlyPart(c, h)
    if h.RigType == Enum.HumanoidRigType.R6 then
        return c:FindFirstChild("Torso")
    end
    return c:FindFirstChild("UpperTorso")
end

local function startFly()
    local c = LP.Character
    local h = c and c:FindFirstChildWhichIsA("Humanoid")
    if not c or not h then return end
    local fp = getFlyPart(c, h)
    if not fp then return end

    setStates(h, false)
    pcall(function() h:ChangeState(Enum.HumanoidStateType.Swimming) end)

    local a = c:FindFirstChild("Animate")
    if a then a.Disabled = true end
    pcall(function()
        for _, v in ipairs(h:GetPlayingAnimationTracks()) do
            v:AdjustSpeed(0)
        end
    end)

    startTpWalk()

    local bg = Instance.new("BodyGyro")
    bg.P = 9e4
    bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    bg.CFrame = fp.CFrame
    bg.Parent = fp

    local bv = Instance.new("BodyVelocity")
    bv.Velocity = Vector3.new(0, 0.1, 0)
    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bv.Parent = fp

    curGyro = bg
    curVel = bv

    pcall(function() h.PlatformStand = true end)

    local ctrl = {f=0,b=0,l=0,r=0}
    local lastctrl = {f=0,b=0,l=0,r=0}
    local curSpeed = 0

    flyConn = RunService.RenderStepped:Connect(function()
        if not nowe then return end
        if not (c and c.Parent and h and h.Parent and h.Health > 0) then return end
        if not (bg and bg.Parent and bv and bv.Parent) then return end

        local md = h.MoveDirection
        ctrl.f, ctrl.b, ctrl.l, ctrl.r = 0, 0, 0, 0
        if md.Z >  0.5 then ctrl.f =  1 end
        if md.Z < -0.5 then ctrl.b = -1 end
        if md.X >  0.5 then ctrl.r =  1 end
        if md.X < -0.5 then ctrl.l = -1 end

        if ctrl.l + ctrl.r ~= 0 or ctrl.f + ctrl.b ~= 0 then
            curSpeed = curSpeed + 0.5 + (curSpeed / maxFlySpeed)
            if curSpeed > maxFlySpeed then curSpeed = maxFlySpeed end
        elseif curSpeed ~= 0 then
            curSpeed = curSpeed - 1
            if curSpeed < 0 then curSpeed = 0 end
        end

        local cam = workspace.CurrentCamera
        if (ctrl.l + ctrl.r) ~= 0 or (ctrl.f + ctrl.b) ~= 0 then
            bv.Velocity = ((cam.CFrame.LookVector * (ctrl.f + ctrl.b))
                + ((cam.CFrame * CFrame.new(ctrl.l + ctrl.r, (ctrl.f + ctrl.b) * 0.2, 0).p) - cam.CFrame.p)) * curSpeed
            lastctrl = {f = ctrl.f, b = ctrl.b, l = ctrl.l, r = ctrl.r}
        elseif curSpeed ~= 0 then
            bv.Velocity = ((cam.CFrame.LookVector * (lastctrl.f + lastctrl.b))
                + ((cam.CFrame * CFrame.new(lastctrl.l + lastctrl.r, (lastctrl.f + lastctrl.b) * 0.2, 0).p) - cam.CFrame.p)) * curSpeed
        else
            bv.Velocity = Vector3.new(0, 0, 0)
        end
        bg.CFrame = cam.CFrame * CFrame.Angles(-math.rad((ctrl.f + ctrl.b) * 50 * curSpeed / maxFlySpeed), 0, 0)
    end)
end

local function stopFly()
    nowe = false
    if flyConn then flyConn:Disconnect(); flyConn = nil end
    stopTpWalk()
    if curGyro then pcall(function() curGyro:Destroy() end); curGyro = nil end
    if curVel  then pcall(function() curVel:Destroy()  end); curVel  = nil end
    local c = LP.Character
    local h = c and c:FindFirstChildWhichIsA("Humanoid")
    if h then
        pcall(function() h.PlatformStand = false end)
        setStates(h, true)
        pcall(function() h:ChangeState(Enum.HumanoidStateType.RunningNoPhysics) end)
    end
    resetAnim(c)
end

local function applyNoclip(char)
    if not char then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") and p.CanCollide then
            p.CanCollide = false
            p:SetAttribute("NoclipSaved", true)
        end
    end
end

local function removeNoclip(char)
    if not char then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") and p:GetAttribute("NoclipSaved") then
            p.CanCollide = true
            p:SetAttribute("NoclipSaved", nil)
        end
    end
end

