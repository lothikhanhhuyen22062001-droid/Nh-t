local function startAutoRun()
    addLoop(function()
        while toggles.autoRun do
            RunService.Heartbeat:Wait()
            local c = LP.Character
            local h = c and c:FindFirstChildWhichIsA("Humanoid")
            if h and h.MoveDirection.Magnitude == 0 then
                local cam = workspace.CurrentCamera
                pcall(function() h:Move(cam.CFrame.LookVector, false) end)
            end
        end
    end)
end

local function setFullBright(on)
    local L = game:GetService("Lighting")
    if on then
        savedLighting = {
            Brightness = L.Brightness,
            ClockTime = L.ClockTime,
            Ambient = L.Ambient,
            OutdoorAmbient = L.OutdoorAmbient,
            GlobalShadows = L.GlobalShadows,
        }
        L.Brightness = 3
        L.ClockTime = 12
        L.Ambient = Color3.fromRGB(200, 200, 200)
        L.OutdoorAmbient = Color3.fromRGB(200, 200, 200)
        L.GlobalShadows = false
    else
        if savedLighting then
            L.Brightness = savedLighting.Brightness
            L.ClockTime = savedLighting.ClockTime
            L.Ambient = savedLighting.Ambient
            L.OutdoorAmbient = savedLighting.OutdoorAmbient
            L.GlobalShadows = savedLighting.GlobalShadows
        end
    end
end

